---
/**
 * Click-to-reveal photo of the kitchen team.
 *
 * NOT YET CLEARED FOR LAUNCH. This is a candid photo of an identifiable
 * person. Before this ships, the person in it has to be happy being on the
 * restaurant's public website — see the launch gaps in DESIGN.md. Deleting this
 * component and its one usage in index.astro removes it entirely.
 *
 * Hidden behind a click rather than shown outright: someone scanning for
 * opening hours should not have a joke thrown at them, and a reveal is a nicer
 * way to meet the kitchen than a photo they did not ask for.
 */
interface Props {
  src: string;
  srcWebp: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
}

const { src, srcWebp, width, height, alt, caption } = Astro.props;
---

<div class="joke" data-joke>
  <button
    type="button"
    class="trigger"
    data-joke-trigger
    aria-expanded="false"
    aria-controls="joke-panel"
  >
    <span class="trigger-label">Meet the kitchen</span>
    <span class="trigger-hint">Tap to say hello</span>
  </button>

  <figure class="panel" id="joke-panel" data-joke-panel hidden>
    <picture>
      <source type="image/webp" srcset={srcWebp} />
      <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
    </picture>
    <figcaption>{caption}</figcaption>
  </figure>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-joke]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-joke-trigger]');
  const panel = document.querySelector<HTMLElement>('[data-joke-panel]');

  if (root && trigger && panel) {
    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';

      if (open) {
        panel.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        // Wait for the transition before hiding, so it animates out. The
        // duration token collapses to 1ms under prefers-reduced-motion, so this
        // is effectively instant for anyone who asked for that.
        const ms = Number.parseFloat(getComputedStyle(root).getPropertyValue('--joke-ms')) || 0;
        window.setTimeout(() => {
          if (trigger.getAttribute('aria-expanded') === 'false') panel.hidden = true;
        }, ms);
      } else {
        panel.hidden = false;
        // Force a reflow so the browser sees the hidden→shown state change
        // before the class lands, otherwise the transition never runs.
        void panel.offsetWidth;
        panel.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>

<style>
  .joke {
    --joke-ms: 480;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .trigger {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-5);
    border: 2px dashed var(--warm-400);
    border-radius: var(--radius-lg);
    color: var(--warm-50);
    text-align: left;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .trigger:hover {
    border-color: var(--mural-sand);
    background: color-mix(in srgb, var(--warm-800) 55%, transparent);
  }

  .trigger-label {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    letter-spacing: var(--letter-spacing-tight);
  }

  .trigger-hint {
    font-size: var(--font-size-sm);
    color: var(--warm-400);
  }

  .trigger[aria-expanded='true'] .trigger-hint {
    color: var(--mural-sand);
  }

  .panel {
    margin: 0;
    max-width: 22rem;
    opacity: 0;
    transform: translateY(var(--reveal-distance)) scale(0.98);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .panel.is-open {
    opacity: 1;
    transform: none;
  }

  .panel img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--mural-sand);
  }

  @media (prefers-reduced-motion: reduce) {
    .joke {
      --joke-ms: 1;
    }

    .panel {
      transform: none;
      transition: none;
    }
  }
</style>

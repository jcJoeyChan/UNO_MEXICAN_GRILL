---
/**
 * The hero's photo mosaic.
 *
 * Replaces the direction contract's original full-bleed photograph — see the
 * FORM AMENDMENT in .impeccable/surfaces/homepage.md and the reasoning in
 * DECISIONS.md. The source photography tops out at 750x600, so a full-bleed
 * hero would upscale to visible softness and undercut the thesis that this is
 * real food rather than stock.
 *
 * The rule this component exists to keep: no photograph is ever rendered wider
 * than its native pixels. Tile sizes below are derived from the real files, not
 * chosen for looks. `sizes` tells the browser the true rendered width so it
 * never over-fetches either.
 */

interface Tile {
  src: string;
  width: number;
  height: number;
  alt: string;
  /** Largest CSS width this tile is ever laid out at. Must be <= width. */
  maxRendered: number;
  span?: 'anchor';
}

const tiles: Tile[] = [
  {
    src: '/images/Spread2.jpg',
    width: 750,
    height: 600,
    maxRendered: 344,
    span: 'anchor',
    alt: 'A spread of dishes on a wood table — grilled meat, rice, beans, tortillas and a drink',
  },
  {
    src: '/images/Burrito.jpg',
    width: 251,
    height: 201,
    maxRendered: 168,
    alt: 'A burrito cut open, filled with rice, beans and grilled meat',
  },
  {
    src: '/images/Nacho_supreme.jpg',
    width: 225,
    height: 225,
    maxRendered: 168,
    alt: 'Nacho supreme — tortilla chips under melted cheese, beans, guacamole and pico',
  },
  {
    src: '/images/Tostada_Salad.jpg',
    width: 289,
    height: 174,
    maxRendered: 168,
    alt: 'A tostada salad served in a crisp tortilla shell with avocado and cheese',
  },
  {
    src: '/images/Spread1.jpg',
    width: 225,
    height: 225,
    maxRendered: 168,
    alt: 'Tacos and sides in paper trays on a wood table',
  },
];

// Guard the rule in code, not just in review: a tile laid out wider than its
// source would ship a soft image, which is the exact failure this form exists
// to avoid.
for (const tile of tiles) {
  // Square tiles with object-fit:cover scale by the larger axis, so check the
  // short side too — checking width alone missed a 3.4% upscale.
  const shortSide = Math.min(tile.width, tile.height);
  if (tile.maxRendered > shortSide) {
    throw new Error(
      `${tile.src} would render at ${tile.maxRendered}px from a ${tile.width}x${tile.height} source ` +
        `(short side ${shortSide}px). ` +
        `Upscaling defeats the point of the mosaic — shrink the tile or supply a larger file.`,
    );
  }
}
---

<div class="mosaic">
  {
    tiles.map((tile, index) => (
      <figure class:list={['tile', tile.span === 'anchor' && 'is-anchor']}>
        <img
          src={tile.src}
          width={tile.width}
          height={tile.height}
          alt={tile.alt}
          sizes={`${tile.maxRendered}px`}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          decoding="async"
        />
      </figure>
    ))
  }
</div>

<style>
  /* Tracks are capped so the anchor never exceeds 344px and the small tiles
     never exceed 168px.
     168 rather than 180 because of Tostada_Salad.jpg: it is landscape
     (289x174) in a square tile, and object-fit:cover scales by the LARGER of
     the two axes. At 180 it scaled 1.034 — a real, if small, upscale. At 168
     every image in the mosaic renders below its native pixels on both axes. */
  /* Three columns, not four: at four the mosaic took ~700px of a 1152px row
     and squeezed the headline into a column so narrow that "Mexican" broke
     across lines. The anchor tile still spans 2x2. */
  /* Six equal squares in one row on a dark ground. The earlier 3-column block
     on beige read as a thumbnail grid; a single wide strip on dark reads as a
     gallery. Equal tiles only — giving one tile a 2-column span made seven
     slots in a six-column grid, which wrapped and left an empty cell. */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .tile {
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--warm-800);
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Spread2 is the only photograph with the pixels to hold a larger tile. */
  /* Kept as a hook: the anchor is the only photo with pixels to spare, so it
     can carry a larger tile if the strip layout ever changes again. */
  .is-anchor {
    border-radius: var(--radius-md);
  }

  @media (max-width: 60rem) {
    .mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .is-anchor {
      grid-column: auto;
    }
  }
</style>

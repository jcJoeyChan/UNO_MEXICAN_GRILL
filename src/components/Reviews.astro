---
/**
 * What customers said, on Google.
 *
 * Every quote is transcribed verbatim from the public listing and links back
 * to its source review — see `_provenance` in reviews.json. PRODUCT.md forbids
 * inventing reviews, and a quote nobody can check against the original is only
 * one step better than an invented one.
 *
 * The strip scrolls horizontally with CSS scroll-snap. It does NOT auto-advance:
 * a carousel that moves on its own steals reading time from anyone slower than
 * its timer, and there is no good timer value.
 */
import reviews from '../content/reviews.json';

const { reviews: items } = reviews;
---

<section class="reviews" aria-labelledby="reviews-heading">
  <div class="head">
    <h2 id="reviews-heading">Reviews</h2>
    <p class="sub">What people say on Google — in their own words.</p>
  </div>

  {/* tabindex="0" is required, not decorative: a scrollable region must be
    reachable by keyboard (WCAG 2.1.1) or arrow-key users cannot pan it. */}
  <ul
    class="strip"
    role="list"
    tabindex="0"
    aria-labelledby="reviews-heading"
    id="reviews-strip"
    data-review-strip
  >
    {
      items.map((review) => (
        <li class="card">
          <blockquote cite={review.url}>
            <p class="quote">“{review.quote}{review.truncated ? ' …' : ''}”</p>
          </blockquote>
          <p class="attrib">
            <span class="author">{review.author}</span>
            <a class="source" href={review.url} target="_blank" rel="noopener noreferrer">
              Read on Google
              <span class="visually-hidden">— full review by {review.author}, opens in a new tab</span>
            </a>
          </p>
        </li>
      ))
    }
  </ul>

  {/* Hidden until the script runs: without JavaScript these buttons would be
       visible and inert. The strip itself still scrolls natively and is
       keyboard-reachable, so nothing is lost. */}
  <div class="controls" data-review-controls hidden>
    <button type="button" class="nav" data-review-prev aria-controls="reviews-strip">
      <span aria-hidden="true">←</span>
      <span class="visually-hidden">Scroll reviews left</span>
    </button>
    <button type="button" class="nav" data-review-next aria-controls="reviews-strip">
      <span aria-hidden="true">→</span>
      <span class="visually-hidden">Scroll reviews right</span>
    </button>
  </div>
</section>

<script>
  const strip = document.querySelector<HTMLElement>('[data-review-strip]');
  const prev = document.querySelector<HTMLButtonElement>('[data-review-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-review-next]');

  if (strip && prev && next) {
    document.querySelector<HTMLElement>('[data-review-controls]')?.removeAttribute('hidden');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const page = () => strip.clientWidth * 0.8;
    const go = (dir: number) =>
      strip.scrollBy({ left: dir * page(), behavior: reduced.matches ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));

    // Disable a button when there is nothing further that way, so the control
    // never lies about what it will do.
    const sync = () => {
      const max = strip.scrollWidth - strip.clientWidth - 1;
      prev.disabled = strip.scrollLeft <= 0;
      next.disabled = strip.scrollLeft >= max;
    };
    strip.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  .reviews {
    background: var(--surface-raised);
    padding: var(--space-8) 0;

    /* This section sits well below the fold, and rendering it measurably
       delayed the hero LCP (96 -> 93 on the homepage, against a floor of 97).
       content-visibility skips its layout and paint until it is scrolled near;
       the intrinsic size is the measured height, so nothing shifts. */
    content-visibility: auto;
    contain-intrinsic-size: auto 32rem;
  }

  .head {
    max-width: var(--content-max);
    margin: 0 auto var(--space-6);
    padding: 0 var(--space-5);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .sub {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    max-width: var(--content-narrow);
  }

  .strip {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-2) var(--space-5) var(--space-5);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--space-5);
    overscroll-behavior-x: contain;
  }

  /* The scroll container is focusable, so it must show a focus ring. */
  .strip:focus-visible {
    outline: 2px solid var(--brand-green-deep);
    outline-offset: 2px;
  }

  .card {
    flex: 0 0 min(22rem, 78vw);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  blockquote {
    margin: 0;
  }

  .quote {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-snug);
    color: var(--text);
  }

  .attrib {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .author {
    font-weight: var(--font-weight-bold);
    color: var(--text-secondary);
  }

  .source {
    color: var(--brand-green-ink);
    font-weight: var(--font-weight-bold);
  }

  .controls {
    display: flex;
    gap: var(--space-2);
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .nav {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: var(--font-size-lg);
    cursor: pointer;
  }

  .nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .nav:not(:disabled):hover {
    border-color: var(--brand-green-deep);
  }
</style>

---
/**
 * Every way to order, in one place.
 *
 * PRODUCT.md is explicit that ordering happens off-site — this component's only
 * job is to route clearly. ChowBus is marked primary because it is the
 * restaurant's own channel; the delivery apps take a cut.
 */
import restaurant from '../content/restaurant.json';

interface Props {
  /** 'menu' inside the rail dropdown, 'block' for in-page use (footer, pages). */
  variant?: 'menu' | 'block';
}

const { variant = 'menu' } = Astro.props;
/**
 * Each partner card carries that partner’s own brand colour as its ground.
 *
 * The colour rides on a custom property rather than a per-channel class so the
 * mapping stays in one typed object; an id with no entry simply gets the
 * default card surface instead of failing silently in CSS.
 *
 * Text stays --text on top: tokens.css records the measured ratio for each,
 * and white would fail on three of the four.
 */
const PARTNER_BG: Record<string, string> = {
  chowbus: 'var(--partner-chowbus-bg)',
  ubereats: 'var(--partner-ubereats-bg)',
  doordash: 'var(--partner-doordash-bg)',
  grubhub: 'var(--partner-grubhub-bg)',
};

const { channels, direct } = restaurant.ordering;
const { phone, phoneHref } = restaurant.contact;
---

<div class:list={['ordering', `is-${variant}`]}>
  <ul class="channels" role="list">
    {
      channels.map((channel) => (
        <li>
          <a
            class:list={['channel', channel.primary && 'is-primary']}
            style={PARTNER_BG[channel.id] && `--partner-bg: ${PARTNER_BG[channel.id]}`}
            href={channel.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="channel-name">
              {channel.name}
              <span class="external" aria-hidden="true">
                ↗
              </span>
              <span class="visually-hidden">opens in a new tab</span>
            </span>
            <span class="channel-detail">{channel.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="direct">
    <a class="channel is-phone" href={phoneHref}>
      <span class="channel-name">{phone}</span>
      <span class="channel-detail">{direct.phoneLabel}</span>
    </a>
    <p class="walk-in">{direct.walkInLabel}</p>
  </div>
</div>

<style>
  .ordering {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .channels {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .is-block .channels {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--partner-bg, var(--surface));
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .channel:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .channel.is-primary {
    border-color: var(--brand-green-deep);
    border-width: 2px;
  }

  .channel-name {
    font-weight: var(--font-weight-bold);
  }

  .channel-detail {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }

  /* --text-muted is measured against --surface only. On a saturated brand
     ground it drops below AA, so partner cards carry full-strength ink and
     rely on size for hierarchy instead of lightness. */
  .channel[style] .channel-detail,
  .channel[style] .external {
    color: var(--text);
  }

  .external {
    font-size: 0.8em;
    color: var(--text-muted);
    margin-left: 0.15em;
  }

  .direct {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .is-phone .channel-name {
    color: var(--brand-green-ink);
  }

  .walk-in {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }
</style>

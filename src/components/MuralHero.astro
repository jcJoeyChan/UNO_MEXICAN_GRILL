---
/**
 * Full-bleed mural hero.
 *
 * Second amendment to the FIRST VIEWPORT. The photo mosaic solved the
 * resolution problem but read as a grid of thumbnails — six 168px tiles cannot
 * carry a homepage. The mural is the only image with the pixels to fill a
 * viewport (5277x2356 after cropping), it is hand-painted, it is unmistakably
 * this restaurant, and it has the restaurant's name painted into it.
 *
 * The scrim is weighted to the LEFT because the painted "UNO MEXICAN GRILL"
 * sign sits on the right of the mural — darkening the left keeps the copy
 * legible without covering the one part of the painting that names the place.
 */
import HoursBadge from './HoursBadge.astro';

interface Props {
  headline: string;
  positioning: string;
  landmark: string;
  phone: string;
  phoneHref: string;
}

const { headline, positioning, landmark, phone, phoneHref } = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  <!-- WebP first, JPEG fallback. The mural is the LCP element, and at ~49%
       fewer bytes WebP is the difference between meeting the performance floor
       and missing it. -->
  <picture>
    <!-- Phones get a different photograph, not a squeezed one. The landscape
         mural is 2.24:1; cover-cropping it into a portrait box threw away the
         painted UNO MEXICAN GRILL sign, which is the whole reason this image
         is the hero. This crop is taken from the 5712x4284 master and framed
         on the sign itself. Media sources come first — the browser takes the
         first <source> whose media matches. -->
    <source
      type="image/webp"
      media="(max-width: 48rem)"
      srcset="/images/mural-portrait-800.webp 800w, /images/mural-portrait-1200.webp 1200w"
      sizes="100vw"
    />
    <source
      type="image/jpeg"
      media="(max-width: 48rem)"
      srcset="/images/mural-portrait-800.jpg 800w, /images/mural-portrait-1200.jpg 1200w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="
        /images/mural-1200.webp 1200w,
        /images/mural-1800.webp 1800w,
        /images/mural-2400.webp 2400w
      "
      sizes="100vw"
    />
    <img
      class="backdrop"
      src="/images/mural-1800.jpg"
      srcset="/images/mural-1200.jpg 1200w, /images/mural-1800.jpg 1800w, /images/mural-2400.jpg 2400w"
      sizes="100vw"
      width="1800"
      height="804"
      alt="The hand-painted desert mural in the dining room, with a painted sign reading UNO Mexican Grill"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="scrim">
    <div class="copy">
      <HoursBadge class="hero-pill" />
      <h1 id="hero-heading">{headline}</h1>
      <p class="positioning">{positioning}</p>

      <div class="actions">
        <a class="btn btn-primary" href="#order">Order Now</a>
        <a class="btn btn-secondary" href="/menu">View Menu</a>
      </div>

      <p class="meta">
        <span>{landmark}</span>
        <a href={phoneHref}>{phone}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--surface-inverse);
  }

  picture {
    position: absolute;
    inset: 0;
  }

  .backdrop {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .scrim {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(78vh, 40rem);
    padding: var(--space-8) var(--space-4);
    /* A steep falloff, not a gradual one.
       A gradual gradient across the full width meant the mural was never
       actually visible: by the time the scrim was light enough to see the
       painting, there was only a sliver of hero left. So the copy lives in a
       dark left column and the scrim clears completely by 62%, leaving the
       right third of the painting — the adobe buildings and the hand-painted
       UNO MEXICAN GRILL sign — fully legible.
       Text contrast is measured by compositing the real mural pixels with this
       gradient; Lighthouse cannot check text over an image. */
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--surface-inverse) 93%, transparent) 0%,
      color-mix(in srgb, var(--surface-inverse) 90%, transparent) 42%,
      color-mix(in srgb, var(--surface-inverse) 30%, transparent) 56%,
      transparent 66%
    );
  }

  .copy {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* Everything readable stays inside the scrim's dark plateau. */
  .copy > * {
    max-width: min(34rem, 42%);
  }

  @media (max-width: 60rem) {
    .copy > * {
      max-width: 34rem;
    }
  }

  h1 {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--font-size-hero);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
    color: var(--warm-50);
  }

  .positioning {
    margin-top: var(--space-4);
    font-size: var(--font-size-lg);
    color: var(--mural-sand);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--brand-green-deep);
    color: var(--brand-white);
  }

  .btn-primary:hover {
    background: var(--brand-green);
    color: var(--surface-inverse);
  }

  /* On the dark hero the secondary button is outlined in sand rather than the
     neutral border token, which would all but vanish. */
  .btn-secondary {
    border: 2px solid var(--mural-sand);
    color: var(--warm-50);
  }

  .btn-secondary:hover {
    background: var(--warm-50);
    color: var(--surface-inverse);
  }

  /* Sand rather than warm-400: measured over the real mural pixels, warm-400
     landed at 4.86:1 — passing, but with almost no margin if the crop ever
     changes. Sand clears it comfortably. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--mural-sand);
  }

  .meta a {
    color: var(--mural-sand);
  }

  @media (max-width: 48rem) {
    /* The portrait crop is 0.8:1, so the hero is sized near that ratio and the
       image arrives almost uncropped. Shorter than it was, so the serape and
       the top of the food strip clear the fold instead of a full screen of
       dark rectangle. */
    .scrim {
      align-items: flex-end;
      min-height: min(64vh, 30rem);
      padding: var(--space-6) var(--space-4);
      /* An even veil, not a plateau with a clear window.

         A gradient that cleared at the top was tried and measured: text in the
         bottom 45% passed at 6.39:1, but the copy block is ~77% of the hero,
         and anything reaching 55% fell to 2.01:1. There is no clear zone to be
         had at this copy length — so the whole frame carries one veil instead.

         Alpha never drops below 0.75, measured by compositing these stops over
         the real crop: warm-50 7.28:1, mural-sand 5.30:1 at the worst pixel in
         the frame. The old 94% plateau measured 11.46:1 and showed 6% of the
         painting; this shows 25% of it everywhere, sign included. */
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--surface-inverse) 82%, transparent) 0%,
        color-mix(in srgb, var(--surface-inverse) 78%, transparent) 60%,
        color-mix(in srgb, var(--surface-inverse) 75%, transparent) 100%
      );
    }

    /* Framed on the sign, which sits right of centre in the crop. */
    .backdrop {
      object-position: 65% 25%;
    }

    /* One step down so the copy block stays inside the scrim’s dark band and
       out of the part of the frame showing the painting. */
    h1 {
      font-size: var(--font-size-3xl);
    }

    .actions {
      margin-top: var(--space-5);
    }

    .meta {
      margin-top: var(--space-4);
    }
  }
</style>

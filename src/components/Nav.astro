---
/**
 * The order rail — the structural thesis of the whole site.
 *
 * From .impeccable/surfaces/homepage.md: "a persistent order/menu bar keeps
 * 'order now' one tap away at all times". It is sticky on every page, at every
 * scroll position, which is what makes this an order-rail layout rather than a
 * hero with a nav bar on top.
 */
import HoursBadge from './HoursBadge.astro';
import OrderingLinks from './OrderingLinks.astro';
import restaurant from '../content/restaurant.json';

const path = Astro.url.pathname;
const links = [
  { href: '/menu', label: 'Menu' },
  { href: '/location', label: 'Location' },
  { href: '/news', label: 'News' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="rail">
  <div class="rail-inner">
    <a class="brand" href="/">
      <img src="/images/Logo.png" width="225" height="225" alt="" />
      <span class="brand-name">{restaurant.name}</span>
    </a>

    <nav class="nav" id="rail-nav" aria-label="Main">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-pill"><HoursBadge /></span>
    </nav>

    <div class="actions">
      <span class="rail-pill"><HoursBadge /></span>

      <div class="order" data-order-root>
        <button
          type="button"
          class="order-button"
          data-order-button
          aria-expanded="false"
          aria-controls="order-panel"
        >
          Order Now <span class="chevron" aria-hidden="true">▾</span>
        </button>
        <div class="order-panel" id="order-panel" data-order-panel hidden>
          <p class="order-heading">Order From</p>
          <OrderingLinks variant="menu" />
        </div>
      </div>

      <button
        type="button"
        class="hamburger"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="rail-nav"
      >
        <span class="visually-hidden">Menu</span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  // --- Order dropdown -------------------------------------------------------
  const root = document.querySelector<HTMLElement>('[data-order-root]');
  const button = document.querySelector<HTMLButtonElement>('[data-order-button]');
  const panel = document.querySelector<HTMLElement>('[data-order-panel]');

  if (root && button && panel) {
    // Anything on the page that offers to start an order opens THIS panel.
    // The hero used to carry a second "Order Now" that scrolled ~1500px down
    // instead: same words, same colour, a completely different outcome.
    // One controller, several triggers, one behaviour.
    const extraTriggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-order-open]'),
    );
    const triggers = [button, ...extraTriggers];

    // The trigger that opened the panel is the one focus returns to.
    let opener: HTMLElement = button;

    const open = (from: HTMLElement = button) => {
      opener = from;
      panel.hidden = false;
      triggers.forEach((t) => t.setAttribute('aria-expanded', 'true'));
      panel.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    const close = (returnFocus = false) => {
      panel.hidden = true;
      triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
      if (returnFocus) opener.focus();
    };

    button.addEventListener('click', () => {
      if (panel.hidden) open(button);
      else close(true);
    });

    // These are real links to #order, which lists the same channels, so the
    // page still works with no JavaScript. With JS they do the faster thing.
    extraTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        if (panel.hidden) open(trigger);
        else close(true);
      });
    });

    // Escape closes and hands focus back to the button that opened it.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) close(true);
    });

    // Clicking away closes. Not a modal — a dropdown should not trap the page.
    document.addEventListener('pointerdown', (event) => {
      if (!panel.hidden && !root.contains(event.target as Node)) close();
    });

    // Tabbing out of the panel closes it, so keyboard users are never left with
    // an invisible open menu behind them.
    root.addEventListener('focusout', () => {
      window.requestAnimationFrame(() => {
        if (!panel.hidden && !root.contains(document.activeElement)) close();
      });
    });
  }

  // --- Mobile nav -----------------------------------------------------------
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('rail-nav');

  if (navToggle && nav) {
    navToggle.addEventListener('click', () => {
      const expanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open', !expanded);
    });
  }
</script>

<style>
  .rail {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .rail-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--content-max);
    min-height: var(--rail-height);
    margin: 0 auto;
    padding: var(--space-2) var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--text);
    flex: none;
  }

  .brand img {
    width: 2.25rem;
    height: 2.25rem;
  }

  .brand-name {
    font-weight: var(--font-weight-black);
    letter-spacing: var(--letter-spacing-tight);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    padding: var(--space-1) 0;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current='page'] {
    color: var(--brand-green-ink);
    box-shadow: inset 0 -2px 0 var(--brand-green-deep);
  }

  /* Visibility is controlled on a Nav-owned wrapper, not by passing a class
     into HoursBadge: that component's own .pill{display:inline-flex} has equal
     specificity and wins on source order, which rendered the pill twice. */
  .nav-pill {
    display: none;
  }

  .rail-pill {
    display: inline-flex;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .order {
    position: relative;
  }

  .order-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--brand-green-deep);
    color: var(--brand-white);
    font-weight: var(--font-weight-bold);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .order-button:hover {
    background: var(--brand-green-ink);
  }

  .chevron {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .order-button[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .order-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    width: min(22rem, calc(100vw - var(--space-6)));
    /* Six routes in a panel hanging off a sticky rail ran past the bottom of
       a short screen — a landscape phone — with no way to reach the phone
       number or the walk-in line. It scrolls itself now. */
    max-height: calc(100dvh - var(--rail-height) - var(--space-6));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .order-heading {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.5rem;
    height: 2.5rem;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .bar {
    display: block;
    height: 2px;
    background: var(--text);
    border-radius: var(--radius-full);
  }

  /* `right: 0` is measured from the order root, not the viewport edge — the
     hamburger and its gap sit to the right of it. At 375 that put the panel’s
     left edge at -36px, and because the page never scrolls horizontally the
     overflow was clipped rather than reachable: the label, the channel names
     and the phone number each lost their first 36px. Anchor to the viewport. */
  @media (max-width: 47.99rem) {
    .order-panel {
      position: fixed;
      top: calc(var(--rail-height) + var(--space-2));
      right: var(--space-3);
      left: var(--space-3);
      width: auto;
      max-height: calc(100dvh - var(--rail-height) - var(--space-5));
    }
  }

  @media (max-width: 47.99rem) {
    /* Hidden visually, not removed. display:none here left the home link with
       no accessible name at all — the logo is alt="" decorative — which
       Lighthouse flagged as link-name. Screen readers still announce "UNO
       Mexican Grill". */
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .hamburger {
      display: flex;
    }

    .rail-pill {
      display: none;
    }

    /* Collapsed nav drops below the rail rather than covering it, so the Order
       button stays reachable while the menu is open. */
    .nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-md);
    }

    .nav.is-open {
      display: flex;
    }

    .nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .nav-pill {
      display: inline-flex;
    }
  }
</style>

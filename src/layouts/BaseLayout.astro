---
/**
 * The shell every page shares — rail, main, footer. Styles are imported here
 * once so no page has to remember to do it.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/reset.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /**
   * LCP image to preload, as [srcset, sizes, type]. The browser cannot discover
   * an image inside a <picture> until CSS and layout resolve; preloading it
   * starts the fetch immediately, which is what a full-bleed hero needs.
   */
  preloadImage?: { srcset: string; sizes: string; type: string };

  /**
   * Social preview image. Absolute URLs are required by Open Graph, so this
   * takes a site-relative path and resolves it against `site`. Dimensions are
   * explicit because crawlers do not fetch the image to find out, and a
   * missing size is the usual reason a preview renders as a small thumbnail.
   */
  ogImage?: { src: string; width: number; height: number; alt: string };
}

/** The mural is the site’s most recognisable image, so it is the default. */
const DEFAULT_OG = {
  src: '/images/mural-1200.jpg',
  width: 1200,
  height: 536,
  alt: 'The hand-painted desert mural in the UNO Mexican Grill dining room',
};

const { title, description, preloadImage, ogImage = DEFAULT_OG } = Astro.props;

// Trailing slashes are stripped so a page has exactly one canonical form.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/Logo.png" />
    <link
      rel="preload"
      href="/fonts/alfa-slab-one-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UNO Mexican Grill" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      /* The rail is sticky, so anchor targets must clear it — otherwise
         jumping to a section hides its heading behind the bar. */
      html {
        scroll-padding-top: calc(var(--rail-height) + var(--space-4));
      }

      .skip-link {
        position: absolute;
        top: var(--space-2);
        left: var(--space-2);
        z-index: 100;
        padding: var(--space-2) var(--space-4);
        background: var(--surface);
        border: 2px solid var(--brand-green-deep);
        border-radius: var(--radius-md);
        font-weight: var(--font-weight-bold);
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }
    </style>
  </body>
</html>

---
/**
 * About.
 *
 * The spine of this page is the six "Fresh is our #1 Goal" claims printed on
 * the restaurant's own menu. They are real, verifiable, and in the restaurant's
 * own words — which is the only kind of story this page is allowed to tell.
 *
 * No origin story has been supplied, so that section is visibly provisional and
 * says exactly what is missing. PRODUCT.md forbids inventing history, and a
 * plausible-sounding "family recipes passed down" paragraph would be a
 * fabrication about a real business.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Serape from '../components/Serape.astro';
import OrderingLinks from '../components/OrderingLinks.astro';
import menuData from '../content/menu.json';
import restaurant from '../content/restaurant.json';

const { heading, claims } = menuData.freshnessClaims;
const { contact } = restaurant;
---

<BaseLayout
  title="About — UNO Mexican Grill, Glen Oaks NY"
  description="Tortillas made from scratch on our own machine and baked when you order. Vegetables selected fresh daily, chicken and steak marinated and grilled to order."
>
  <section class="intro">
    <div class="section-inner">
      <h1>{heading}</h1>
      <p class="lede">Everything below is printed on our menu, and it is how we actually cook.</p>
    </div>
  </section>

  <Serape weight="band" />

  <section class="claims-section" aria-labelledby="claims-heading">
    <div class="section-inner">
      <h2 id="claims-heading" class="visually-hidden">How we cook</h2>
      <ol class="claims" role="list">
        {
          claims.map((claim, index) => (
            <li>
              <span class="num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p>{claim}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="photos" aria-labelledby="photos-heading">
    <div class="section-inner">
      <h2 id="photos-heading">The room</h2>
      <p class="note-dark">
        A desert mural runs the length of the dining room, painted by hand. Eat in under it, or take
        it to go.
      </p>
      <div class="photo-row">
        <figure>
          <img
            src="/images/mural-1200.jpg"
            width="1200"
            height="536"
            alt="The hand-painted desert mural along the dining room wall"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure>
          <img
            src="/images/OUTSIDE.jpg"
            width="348"
            height="348"
            alt="The UNO Mexican Grill storefront in Glen Oaks Shopping Center"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="story" aria-labelledby="story-heading">
    <div class="section-inner narrow">
      <p class="provisional">Placeholder — we haven't written this yet</p>
      <h2 id="story-heading">Our story</h2>
      <p class="note">
        This is where the story of the restaurant will go — who started it, when it opened, and how
        it ended up on Union Turnpike. We would rather leave this blank than make something up, so
        it stays empty until the owners tell it to us.
      </p>
      <p class="note">
        In the meantime: <a href={contact.phoneHref}>{contact.phone}</a>, or come in and ask.
      </p>
    </div>
  </section>

  <section class="order-block" aria-labelledby="order-heading">
    <div class="section-inner">
      <h2 id="order-heading">Try it</h2>
      <OrderingLinks variant="block" />
    </div>
  </section>
</BaseLayout>

<style>
  .section-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .narrow {
    max-width: var(--content-narrow);
    margin-inline: auto;
  }

  section {
    padding: var(--space-8) var(--space-4);
  }

  .intro {
    padding-top: var(--space-9);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-display);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
    max-width: 16ch;
  }

  .lede {
    margin-top: var(--space-4);
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: var(--content-narrow);
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    letter-spacing: var(--letter-spacing-tight);
  }

  .claims-section {
    background: var(--mural-sand);
  }

  .claims {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 46rem) {
    .claims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-7);
    }
  }

  .claims li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    color: var(--mural-terracotta-ink);
    font-variant-numeric: tabular-nums;
  }

  .claims p {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-snug);
  }

  .photos {
    background: var(--surface-inverse);
    color: var(--warm-50);
  }

  .note-dark {
    margin-top: var(--space-3);
    color: var(--mural-sand);
    max-width: 52ch;
  }

  .photo-row {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 46rem) {
    .photo-row {
      grid-template-columns: 2.2fr 1fr;
      align-items: start;
    }
  }

  .photo-row figure {
    margin: 0;
  }

  .photo-row img {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .story {
    background: var(--mural-sky-wash);
  }

  .provisional {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: var(--state-seasonal-bg);
    color: var(--state-seasonal-text);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .note {
    margin-top: var(--space-3);
    color: var(--warm-600);
  }

  .order-block :global(.ordering) {
    margin-top: var(--space-4);
  }
</style>

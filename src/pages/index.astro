---
/**
 * Homepage — order-rail hero, second form amendment.
 *
 * The mural now carries the first viewport; the food photography moves to a
 * dark strip immediately below it. See DECISIONS.md: the mosaic solved the
 * resolution problem but read as thumbnails, and small photographs look
 * intentional on a dark ground and cheap on beige.
 *
 * Sections alternate real grounds — mural, dark, sand, sky — so the page has
 * rhythm as you scroll instead of one flat off-white.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MuralHero from '../components/MuralHero.astro';
import HeroMosaic from '../components/HeroMosaic.astro';
import MenuPreview from '../components/MenuPreview.astro';
import OrderingLinks from '../components/OrderingLinks.astro';
import Serape from '../components/Serape.astro';
import KitchenJoke from '../components/KitchenJoke.astro';
import restaurant from '../content/restaurant.json';
import { sortCategories, countItems } from '../lib/menu';

const entries = await getCollection('menu');
const categories = sortCategories(entries.map((entry) => entry.data));
const total = countItems(categories);
const { contact, hours } = restaurant;
---

<BaseLayout
  title="UNO Mexican Grill — Tex-Mex takeout & dine-in in Glen Oaks, Queens"
  description="Casual Tex-Mex takeout and dine-in on Union Turnpike in Glen Oaks, Queens. Tacos, burritos, quesadillas and rice platters. Open 7 days, 11 am to 9:30 pm."
  preloadImage={{
    srcset:
      '/images/mural-1200.webp 1200w, /images/mural-1800.webp 1800w, /images/mural-2400.webp 2400w',
    sizes: '100vw',
    type: 'image/webp',
  }}
>
  <MuralHero
    headline="Tex-Mex, made when you order it."
    positioning="Tortillas off our own machine, baked and grilled when you order. Takeout or dine in, seven days a week on Union Turnpike."
    landmark={contact.landmark}
    phone={contact.phone}
    phoneHref={contact.phoneHref}
  />

  <Serape weight="band" />

  <section class="food" aria-labelledby="food-heading">
    <div class="section-inner">
      <h2 id="food-heading">What comes out of the kitchen</h2>
      <p class="note-dark">
        Every photograph here is our food, in our trays, on our tables. Nothing borrowed.
      </p>
      <figure class="grill">
        <picture>
          <source
            type="image/webp"
            srcset="/images/grill-900.webp 900w, /images/grill-1400.webp 1400w, /images/grill-2000.webp 2000w"
            sizes="(min-width: 72rem) 68rem, 100vw"
          />
          <img
            src="/images/grill-1400.jpg"
            srcset="/images/grill-900.jpg 900w, /images/grill-1400.jpg 1400w, /images/grill-2000.jpg 2000w"
            sizes="(min-width: 72rem) 68rem, 100vw"
            width="1400"
            height="1050"
            alt="Chicken and steak on the flat-top grill, marked from the bars, mid-service"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption>
          Chicken and steak marinated, then grilled to order — not held under a lamp.
        </figcaption>
      </figure>

      <div class="strip">
        <HeroMosaic />
      </div>

      <div class="joke-slot">
        <KitchenJoke
          src="/images/kitchen-joke-700.jpg"
          srcWebp="/images/kitchen-joke-700.webp 700w, /images/kitchen-joke-1100.webp 1100w"
          width={700}
          height={933}
          alt="A member of the kitchen team pulling a face for the camera while working the line"
          caption="One of the team, caught mid-service."
        />
      </div>
    </div>
  </section>

  <section class="order" id="order" aria-labelledby="order-heading">
    <div class="section-inner">
      <h2 id="order-heading">Order from</h2>
      <p class="note">Pickup, delivery, call ahead or walk in — {hours.summary.toLowerCase()}.</p>
      <OrderingLinks variant="block" />
    </div>
  </section>

  <Serape weight="band" />

  <section class="preview-section" aria-labelledby="preview-heading">
    <div class="section-inner">
      <header class="preview-head">
        <h2 id="preview-heading">On the menu</h2>
        <p class="note">
          A few favourites. All {total} items, with prices, on the <a href="/menu">full menu</a>.
        </p>
      </header>
      <MenuPreview
        categories={categories}
        feature={['tacos', 'burritos', 'quesadillas', 'tostada-salads']}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .section-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  section {
    padding: var(--space-8) var(--space-4);
    scroll-margin-top: calc(var(--rail-height) + var(--space-4));
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
  }

  .note {
    margin-top: var(--space-3);
    color: var(--text-secondary);
  }

  /* --- food: dark ground. Small photographs read as a gallery on dark and as
         clip art on beige, which is what the beige version looked like. --- */
  .food {
    background: var(--surface-inverse);
    color: var(--warm-50);
  }

  .note-dark {
    margin-top: var(--space-3);
    color: var(--warm-400);
    max-width: 48ch;
  }

  .grill {
    margin: var(--space-6) 0 0;
  }

  .grill img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .grill figcaption {
    margin-top: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--mural-sand);
  }

  .strip {
    margin-top: var(--space-6);
  }

  .joke-slot {
    margin-top: var(--space-7);
  }

  /* --- order: sand. The primary action gets the most legible ground. --- */
  .order {
    background: var(--mural-sand);
  }

  .order .note {
    color: var(--warm-600);
  }

  /* --- menu preview: sky wash, straight off the mural's painted sky. --- */
  .preview-section {
    background: var(--mural-sky-wash);
  }

  .preview-head {
    margin-bottom: var(--space-6);
  }
</style>

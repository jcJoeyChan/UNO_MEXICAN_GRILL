---
/**
 * Not found.
 *
 * Astro emits this as dist/404.html and Netlify serves it automatically for
 * any unmatched path. It uses the normal shell, so a visitor who mistypes a
 * URL still has the order rail, the hours pill and the footer — the three
 * things someone looking for a restaurant actually needs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Serape from '../components/Serape.astro';
import restaurant from '../content/restaurant.json';

const { contact } = restaurant;
---

<BaseLayout
  title="Page not found — UNO Mexican Grill, Glen Oaks NY"
  description="That page does not exist. Find the full menu, hours and directions for UNO Mexican Grill in Glen Oaks, Queens."
>
  <section class="intro">
    <div class="section-inner">
      <p class="code">404</p>
      <h1>That page isn't here</h1>
      <p class="lede">
        The link may be old or mistyped. Everything else is still where you left it.
      </p>
      <p class="actions">
        <a class="btn btn-primary" href="/menu">See the menu</a>
        <a class="btn btn-secondary" href="/">Go home</a>
      </p>
      <p class="call">
        Or call us on <a href={contact.phoneHref}>{contact.phone}</a>.
      </p>
    </div>
  </section>

  <Serape weight="band" />
</BaseLayout>

<style>
  .intro {
    background: var(--surface);
    padding: var(--space-9) 0;
  }

  .section-inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .code {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    color: var(--text-muted);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .lede {
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }

  .call {
    margin: 0;
    color: var(--text-secondary);
  }

  .call a {
    color: var(--brand-green-ink);
    font-weight: var(--font-weight-bold);
  }
</style>

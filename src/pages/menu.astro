---
/**
 * The full menu — all 12 categories, all 79 items.
 *
 * Everything on this page comes from the restaurant's own printed menu, read
 * through the content collection. Nothing here is invented.
 */
import { getCollection } from 'astro:content';
import { statSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCategory from '../components/MenuCategory.astro';
import OrderingLinks from '../components/OrderingLinks.astro';
import Serape from '../components/Serape.astro';
import { sortCategories, countItems, isSeasonal } from '../lib/menu';

const entries = await getCollection('menu');
const categories = sortCategories(entries.map((entry) => entry.data));
const total = countItems(categories);

// Read the real file size at build time so the download label can never drift
// from the file it describes.
//
// Resolved from process.cwd(), not import.meta.url: during `astro build` this
// module is bundled into dist/.prerender/, so a URL relative to the module
// resolves to dist/public/menu.pdf and the build dies with ENOENT.
const pdfBytes = statSync(join(process.cwd(), 'public/menu.pdf')).size;
const pdfSize = `${(pdfBytes / 1024 / 1024).toFixed(1)} MB`;
---

<BaseLayout
  title="Menu — UNO Mexican Grill, Glen Oaks NY"
  description="The full UNO Mexican Grill menu with prices — tacos, burritos, quesadillas, nachos, rice platters, tostada salads, fajitas by the pound, sides and more."
>
  <header class="page-head">
    <div class="head-inner">
      <h1>Menu</h1>
      <p class="lede">
        {total} items across {categories.length} categories. Order for pickup or delivery, call ahead,
        or walk in.
      </p>

      <p class="convention">
        <span class="veg" aria-hidden="true">*</span> marks a vegetarian item.
      </p>

      <nav class="jump" aria-label="Menu categories">
        <ul role="list">
          {
            categories.map((category) => (
              <li>
                <a href={`#${category.id}`}>
                  {category.name}
                  {isSeasonal(category) && (
                    <span class="jump-seasonal" aria-hidden="true">
                      ·
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <Serape weight="band" />

  {
    categories.map((category, index) => (
      <MenuCategory category={category} tone={index % 2 === 1 ? 'raised' : 'plain'} />
    ))
  }

  <Serape weight="band" />

  <div class="tail">
    <section class="order-block" aria-labelledby="order-heading">
      <h2 id="order-heading">Ready to order?</h2>
      <OrderingLinks variant="block" />
    </section>

    <p class="download">
      <a href="/menu.pdf" download>Download the printed menu</a>
      <span class="download-meta">PDF, {pdfSize}</span>
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: var(--space-8) var(--space-4);
    background: var(--mural-sand);
  }

  .head-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .tail {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-display);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
  }

  .convention {
    margin-top: var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .veg {
    color: var(--brand-green-ink);
    font-weight: var(--font-weight-bold);
  }

  .jump {
    margin-top: var(--space-5);
  }

  /* One serape rule per page, under the header. The motif belongs to the
     printed menu, but repeating it above all twelve categories would turn a
     signature into wallpaper. */
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jump a {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    color: var(--warm-600);
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .jump-seasonal {
    color: var(--state-seasonal-text);
    font-weight: var(--font-weight-bold);
  }

  .order-block {
    padding: var(--space-6);
    background: var(--mural-sky-wash);
    border-radius: var(--radius-lg);
  }

  .order-block h2 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--space-4);
  }

  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--font-size-sm);
  }

  .download-meta {
    color: var(--text-muted);
  }
</style>
